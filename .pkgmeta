# BigWigs packager (https://github.com/BigWigsMods/packager). Checked against the packager's
# source (v2, November 2026): it maps "## Interface: 160xx" to the Forever game type, and
# move-folders handles the core folder having the same name as the package.
# One repo holds the core and every official pack; each becomes its own addon folder in
# the zip. tools/check_all.py --release checks that every pack is listed here.
package-as: RPGDialogue

move-folders:
  RPGDialogue/RPGDialogue: RPGDialogue
  RPGDialogue/RPGDialogue_World: RPGDialogue_World
  RPGDialogue/RPGDialogue_Elwynn: RPGDialogue_Elwynn
  RPGDialogue/RPGDialogue_Westfall: RPGDialogue_Westfall
  RPGDialogue/RPGDialogue_Stormwind: RPGDialogue_Stormwind
  RPGDialogue/RPGDialogue_Zephras: RPGDialogue_Zephras
  RPGDialogue/RPGDialogue_Redridge: RPGDialogue_Redridge
  RPGDialogue/RPGDialogue_Duskwood: RPGDialogue_Duskwood
  RPGDialogue/RPGDialogue_Ironforge: RPGDialogue_Ironforge
  RPGDialogue/RPGDialogue_Wetlands: RPGDialogue_Wetlands
  RPGDialogue/RPGDialogue_Moonglade: RPGDialogue_Moonglade
  RPGDialogue/RPGDialogue_Darnassus: RPGDialogue_Darnassus
  RPGDialogue/RPGDialogue_ThunderBluff: RPGDialogue_ThunderBluff
  RPGDialogue/RPGDialogue_Barrens: RPGDialogue_Barrens
  RPGDialogue/RPGDialogue_Ashenvale: RPGDialogue_Ashenvale
  RPGDialogue/RPGDialogue_Hillsbrad: RPGDialogue_Hillsbrad
  RPGDialogue/RPGDialogue_Darkshore: RPGDialogue_Darkshore
  RPGDialogue/RPGDialogue_Orgrimmar: RPGDialogue_Orgrimmar
  RPGDialogue/RPGDialogue_Undercity: RPGDialogue_Undercity
  RPGDialogue/RPGDialogue_LochModan: RPGDialogue_LochModan
  RPGDialogue/RPGDialogue_Stonetalon: RPGDialogue_Stonetalon
  RPGDialogue/RPGDialogue_Stranglethorn: RPGDialogue_Stranglethorn
  RPGDialogue/RPGDialogue_ThousandNeedles: RPGDialogue_ThousandNeedles
  RPGDialogue/RPGDialogue_Durotar: RPGDialogue_Durotar
  RPGDialogue/RPGDialogue_Mulgore: RPGDialogue_Mulgore
  RPGDialogue/RPGDialogue_Tirisfal: RPGDialogue_Tirisfal
  RPGDialogue/RPGDialogue_Teldrassil: RPGDialogue_Teldrassil
  RPGDialogue/RPGDialogue_Silverpine: RPGDialogue_Silverpine
  RPGDialogue/RPGDialogue_Desolace: RPGDialogue_Desolace
  RPGDialogue/RPGDialogue_Tanaris: RPGDialogue_Tanaris
  RPGDialogue/RPGDialogue_Dustwallow: RPGDialogue_Dustwallow
  RPGDialogue/RPGDialogue_Feralas: RPGDialogue_Feralas
  RPGDialogue/RPGDialogue_SwampOfSorrows: RPGDialogue_SwampOfSorrows
  RPGDialogue/RPGDialogue_Arathi: RPGDialogue_Arathi
  RPGDialogue/RPGDialogue_Hinterlands: RPGDialogue_Hinterlands
  RPGDialogue/RPGDialogue_Badlands: RPGDialogue_Badlands
  RPGDialogue/RPGDialogue_UnGoro: RPGDialogue_UnGoro
  RPGDialogue/RPGDialogue_Winterspring: RPGDialogue_Winterspring
  RPGDialogue/RPGDialogue_Felwood: RPGDialogue_Felwood
  RPGDialogue/RPGDialogue_SearingGorge: RPGDialogue_SearingGorge
  RPGDialogue/RPGDialogue_Riverglades: RPGDialogue_Riverglades
  RPGDialogue/RPGDialogue_WesternPlaguelands: RPGDialogue_WesternPlaguelands
  RPGDialogue/RPGDialogue_BurningSteppes: RPGDialogue_BurningSteppes
  RPGDialogue/RPGDialogue_BlastedLands: RPGDialogue_BlastedLands
  RPGDialogue/RPGDialogue_Azshara: RPGDialogue_Azshara
  RPGDialogue/RPGDialogue_Silithus: RPGDialogue_Silithus
  RPGDialogue/RPGDialogue_EasternPlaguelands: RPGDialogue_EasternPlaguelands
  RPGDialogue/RPGDialogue_Dalaran: RPGDialogue_Dalaran
  RPGDialogue/RPGDialogue_Hyjal: RPGDialogue_Hyjal
  RPGDialogue/RPGDialogue_Shendralas: RPGDialogue_Shendralas

# Paths are from the repo root; "*.md" matches at any depth (bash case patterns), which
# keeps voice bibles, PLAN.md files and pack changelogs out of the zip.
ignore:
  - tests
  - tools
  - reference
  - "*.md"
  - "**/bibles"
  - banned_phrases.txt
  - .github

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
